# Which networks to run: mainnet, sepolia, or mainnet,sepolia
COMPOSE_PROFILES=mainnet

# L1 endpoints. The beacon endpoint must serve blobs (eth/v1/beacon/blob_sidecars).
L1_MAINNET_RPC=
L1_MAINNET_BEACON=
L1_SEPOLIA_RPC=
L1_SEPOLIA_BEACON=

# Where chain data is stored. Point this at a large NVMe disk.
DATA_DIR=./data

# How much history op-reth keeps. Set before the first start; changing it later needs a resync.
# Leave exactly one RETH_HISTORY line uncommented:
#
# receipts (recommended): receipts/logs for every block; state for the last 10064 blocks
RETH_HISTORY=--prune.sender-recovery.full --prune.account-history.distance 10064 --prune.storage-history.distance 10064
# full (smallest): receipts/logs for the last 1209600 blocks (~14 days on Unichain, ~28 on OP; the
# supernode needs at least 7); state for the last 10064 blocks
# RETH_HISTORY=--full --prune.receipts.distance 1209600
# archive (largest): everything, including state at any block
# RETH_HISTORY=

# Interface the op-reth HTTP/WS ports listen on. 0.0.0.0 exposes them to the network and
# bypasses host firewalls (ufw/firewalld) because Docker publishes ports directly.
RPC_BIND=127.0.0.1

# Optional image overrides
# OP_RETH_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-reth:v2.8.0
# OP_SUPERNODE_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-supernode:v1.1.0
